<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- WhaleGo light theme tokens (docs/GUI.md section 10.2). Only Color.* tokens live here; brush/effect
         derivations live in Shared.xaml (brushes) and are overridden by HighContrast.xaml. -->
    <Color x:Key="Color.Canvas">#FFFFFF</Color>
    <Color x:Key="Color.Surface">#F6F7FB</Color>
    <Color x:Key="Color.SurfaceAlt">#EEF1F6</Color>
    <Color x:Key="Color.Sidebar">#FAFBFD</Color>
    <Color x:Key="Color.Text.Primary">#1A1D24</Color>
    <Color x:Key="Color.Text.Secondary">#5A6270</Color>
    <Color x:Key="Color.Text.Tertiary">#8A93A3</Color>
    <Color x:Key="Color.Accent">#4D6BFE</Color>
    <Color x:Key="Color.AccentHover">#3F5BEA</Color>
    <Color x:Key="Color.AccentPressed">#3450DC</Color>
    <Color x:Key="Color.AccentSubtle">#EEF1FF</Color>
    <Color x:Key="Color.Border">#E4E7EE</Color>
    <Color x:Key="Color.BorderStrong">#CFD6E4</Color>
    <Color x:Key="Color.FocusRing">#664D6BFE</Color>
    <Color x:Key="Color.Success">#2E9E6B</Color>
    <Color x:Key="Color.Warning">#C9820A</Color>
    <Color x:Key="Color.Danger">#D93B3B</Color>
    <Color x:Key="Color.Idle">#8A93A3</Color>
    <Color x:Key="Color.Shadow">#140F1115</Color>

    <!-- Theme brushes (light). Swapped with the dictionary so views re-resolve DynamicResource Brush.*. -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#F6F7FB" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EEF1F6" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FAFBFD" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1A1D24" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#5A6270" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#8A93A3" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#4D6BFE" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#3F5BEA" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3450DC" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#EEF1FF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E4E7EE" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CFD6E4" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#664D6BFE" />
    <SolidColorBrush x:Key="Brush.Success" Color="#2E9E6B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#C9820A" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#D93B3B" />
    <SolidColorBrush x:Key="Brush.Idle" Color="#8A93A3" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="#140F1115" />

    <!-- Cards use a soft shadow on the light canvas; dark/high-contrast switch this off (border layering). -->
    <DropShadowEffect x:Key="Effect.Card" Color="#0F1115" BlurRadius="22" ShadowDepth="2" Direction="270" Opacity="0.10" />
</ResourceDictionary>
