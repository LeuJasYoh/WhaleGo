<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- High contrast theme: readability wins over branding. Color tokens keep the documented key set
         (so tooling/tests keep working), while the observable brushes map to live SystemColors below
         and therefore follow the user's contrast theme. -->
    <Color x:Key="Color.Canvas">#000000</Color>
    <Color x:Key="Color.Surface">#000000</Color>
    <Color x:Key="Color.SurfaceAlt">#1A1A1A</Color>
    <Color x:Key="Color.Sidebar">#000000</Color>
    <Color x:Key="Color.Text.Primary">#FFFFFF</Color>
    <Color x:Key="Color.Text.Secondary">#FFFFFF</Color>
    <Color x:Key="Color.Text.Tertiary">#C0C0C0</Color>
    <Color x:Key="Color.Accent">#0078D7</Color>
    <Color x:Key="Color.AccentHover">#3399FF</Color>
    <Color x:Key="Color.AccentPressed">#005A9E</Color>
    <Color x:Key="Color.AccentSubtle">#1F1F1F</Color>
    <Color x:Key="Color.Border">#FFFFFF</Color>
    <Color x:Key="Color.BorderStrong">#FFFFFF</Color>
    <Color x:Key="Color.FocusRing">#FFFFFFFF</Color>
    <Color x:Key="Color.Success">#00FF00</Color>
    <Color x:Key="Color.Warning">#FFFF00</Color>
    <Color x:Key="Color.Danger">#FF0000</Color>
    <Color x:Key="Color.Idle">#C0C0C0</Color>
    <Color x:Key="Color.Shadow">#00000000</Color>

    <!-- System color overrides (later merged dictionary wins for Brush.* lookups). -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.Idle" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

    <x:Null x:Key="Effect.Card" />
</ResourceDictionary>
