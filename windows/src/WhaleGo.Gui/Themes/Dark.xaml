<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- WhaleGo dark theme tokens (docs/GUI.md section 10.2). Semantic colors are brightened for contrast. -->
    <Color x:Key="Color.Canvas">#0F1115</Color>
    <Color x:Key="Color.Surface">#161A22</Color>
    <Color x:Key="Color.SurfaceAlt">#1D222C</Color>
    <Color x:Key="Color.Sidebar">#12151B</Color>
    <Color x:Key="Color.Text.Primary">#E8EAF0</Color>
    <Color x:Key="Color.Text.Secondary">#9AA3B2</Color>
    <Color x:Key="Color.Text.Tertiary">#6E7686</Color>
    <Color x:Key="Color.Accent">#6D86FF</Color>
    <Color x:Key="Color.AccentHover">#7E94FF</Color>
    <Color x:Key="Color.AccentPressed">#8FA3FF</Color>
    <Color x:Key="Color.AccentSubtle">#1C2340</Color>
    <Color x:Key="Color.Border">#242A36</Color>
    <Color x:Key="Color.BorderStrong">#333B4A</Color>
    <Color x:Key="Color.FocusRing">#8C6D86FF</Color>
    <Color x:Key="Color.Success">#45C08A</Color>
    <Color x:Key="Color.Warning">#E8B45A</Color>
    <Color x:Key="Color.Danger">#FF6B6B</Color>
    <Color x:Key="Color.Idle">#6E7686</Color>
    <Color x:Key="Color.Shadow">#73000000</Color>

    <!-- Theme brushes (dark). Swapped with the dictionary so views re-resolve DynamicResource Brush.*. -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="#0F1115" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#161A22" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#1D222C" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#12151B" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E8EAF0" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#9AA3B2" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#6E7686" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#6D86FF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#7E94FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#8FA3FF" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#1C2340" />
    <SolidColorBrush x:Key="Brush.Border" Color="#242A36" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#333B4A" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#8C6D86FF" />
    <SolidColorBrush x:Key="Brush.Success" Color="#45C08A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E8B45A" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF6B6B" />
    <SolidColorBrush x:Key="Brush.Idle" Color="#6E7686" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="#73000000" />

    <!-- No drop shadows in dark mode: layers are separated by borders only. -->
    <x:Null x:Key="Effect.Card" />
</ResourceDictionary>
