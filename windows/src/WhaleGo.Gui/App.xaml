<Application x:Class="WhaleGo.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: the composition root (GuiShell) owns window creation. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Shared.xaml" />
                <!-- Theme slot: ThemeService replaces exactly this dictionary at runtime. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Views/Controls/FieldTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
