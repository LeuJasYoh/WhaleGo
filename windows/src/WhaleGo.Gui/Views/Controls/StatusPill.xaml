<UserControl x:Class="WhaleGo.Gui.Views.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self"
             Focusable="False"
             IsTabStop="False"
             AutomationProperties.Name="{Binding Label, ElementName=Self}"
             AutomationProperties.HelpText="运行状态徽标：颜色、文字与图标三重编码">
    <Border x:Name="Shell" CornerRadius="11" Height="22" Padding="10,0" HorizontalAlignment="Left" Background="Transparent">
        <Grid>
            <Border x:Name="Tint" CornerRadius="11" Opacity="0.14" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,6,0" />
                <TextBlock x:Name="Caption" FontSize="{DynamicResource Font.Size.Badge}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
