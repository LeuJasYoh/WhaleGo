<UserControl x:Class="WhaleGo.Gui.Views.Controls.PageActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WhaleGo.Gui.Views.Controls">
    <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0" Padding="0,10">
        <StackPanel>
            <controls:InlineBanner x:Name="SuccessBanner" Severity="Info" />
            <controls:InlineBanner x:Name="WarningBanner" Severity="Warning" />
            <controls:InlineBanner x:Name="ErrorBanner" Severity="Danger" />
            <controls:InlineBanner x:Name="RestartBanner" Severity="Info" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center"
                           Text="修改后点「应用」保存；仅保存当前页" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="刷新" Style="{DynamicResource Button.Secondary}" Command="{Binding RefreshCommand}"
                            Margin="0,0,8,0" AutomationProperties.Name="重新加载配置" />
                    <Button Content="恢复" Style="{DynamicResource Button.Secondary}" Command="{Binding RevertCommand}"
                            Margin="0,0,8,0" AutomationProperties.Name="恢复上次加载的配置" />
                    <Button Content="应用" Style="{DynamicResource Button.Primary}" Command="{Binding ApplyCommand}"
                            AutomationProperties.Name="应用当前页配置" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
