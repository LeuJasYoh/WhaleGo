<UserControl x:Class="WhaleGo.Gui.Views.Controls.ConfigForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WhaleGo.Gui.Views.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.CardTitle}" />
                                <TextBlock Text="{Binding Description}" Style="{DynamicResource Text.Caption}"
                                           Margin="0,4,0,4"
                                           Visibility="{Binding Description, Converter={StaticResource StringToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Fields}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <controls:PageActionBar Grid.Row="1" />
    </Grid>
</UserControl>
