<UserControl x:Class="WhaleGo.Gui.Views.Controls.InlineBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Grid>
        <Border x:Name="Tint" CornerRadius="8" Opacity="0.10" />
        <Border x:Name="Frame" CornerRadius="8" BorderThickness="1">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Icon" Width="18" Height="18" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Top">
                    <TextBlock x:Name="IconText" Text="!" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{DynamicResource Text.SectionTitle}" FontSize="12" Visibility="Collapsed" />
                    <TextBlock x:Name="MessageText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0"
                               AutomationProperties.Name="提示内容" />
                </StackPanel>
                <Button x:Name="ActionButton" Grid.Column="2" Style="{DynamicResource Button.Ghost}" Height="24"
                        MinWidth="0" Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                        Content="{Binding ActionText, ElementName=Self}"
                        Command="{Binding ActionCommand, ElementName=Self}"
                        AutomationProperties.Name="{Binding ActionText, ElementName=Self}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
