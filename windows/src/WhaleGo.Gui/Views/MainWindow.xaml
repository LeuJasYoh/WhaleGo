<Window x:Class="WhaleGo.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WhaleGo.Gui.Views.Controls"
        xmlns:views="clr-namespace:WhaleGo.Gui.Views"
        xmlns:vm="clr-namespace:WhaleGo.Gui.ViewModels"
        Title="WhaleGo 设置"
        Width="880" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ApplyCurrentCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <views:ConnectionPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PolicyViewModel}">
            <views:PolicyPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
            <views:PrivacyPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutPage />
        </DataTemplate>
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:PageBaseViewModel}">
            <TextBlock Text="{Binding NavLabel}" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left navigation ─────────────────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,18,16,14">
                        <Path Data="M 2,14 C 2,6 10,2 18,4 L 30,10 L 18,16 C 12,22 4,22 2,14 Z"
                              Fill="{DynamicResource Brush.Accent}" Width="24" Height="20" Stretch="Uniform"
                              VerticalAlignment="Center" />
                        <TextBlock Text="WhaleGo" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="NavList" Grid.Row="1" Style="{DynamicResource Nav.ListBox}"
                             ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                             ItemTemplate="{StaticResource NavItemTemplate}"
                             AutomationProperties.Name="设置页面导航" />
                    <TextBlock Grid.Row="2" Text="{Binding VersionText}" Style="{DynamicResource Text.Hint}"
                               Margin="16,10,16,12" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- ── Content ─────────────────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="24,12,24,0" Height="32">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="主题" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Border Style="{DynamicResource Segment.Container}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="跟随系统" GroupName="ThemeSegment"
                                             Style="{DynamicResource Segment.Radio}"
                                             IsChecked="{Binding IsSystemTheme, Mode=TwoWay}"
                                             AutomationProperties.Name="主题跟随系统" />
                                <RadioButton Content="浅色" GroupName="ThemeSegment"
                                             Style="{DynamicResource Segment.Radio}"
                                             IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                             AutomationProperties.Name="浅色主题" />
                                <RadioButton Content="深色" GroupName="ThemeSegment"
                                             Style="{DynamicResource Segment.Radio}"
                                             IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                             AutomationProperties.Name="深色主题" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}"
                                Margin="24,10,24,18" Focusable="False"
                                AutomationProperties.Name="设置页面内容" />
            </Grid>
        </Grid>

        <!-- ── Status bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:StatusPill Level="{Binding StatusLevel}" Label="{Binding StatusLabel}"
                                     VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusDetail}" Style="{DynamicResource Text.Hint}"
                           VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Style="{DynamicResource Text.Hint}" VerticalAlignment="Center">
                    <Run Text="{Binding ListenText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding VersionText, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- Theme switch cross-fade veil (150ms, honors ClientAreaAnimation). -->
        <Border x:Name="ThemeVeil" Grid.RowSpan="2" Background="{DynamicResource Brush.Canvas}"
                Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
